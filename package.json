{
  "name": "lebane-qa-automation",
  "version": "1.0.0",
  "description": "QA Automation – Lista de precios de unidades (Lebane) con Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\""
  },
  "keywords": [],
  "author": "Andrea Díaz",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.4",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "prettier": "^3.9.9",
    "typescript": "5.9"
  }
}
