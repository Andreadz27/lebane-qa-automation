{
  "name": "lebane-qa-automation",
  "version": "1.0.0",
  "description": "QA Automation – Lista de precios de unidades (Lebane) con Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\"",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:all-browsers": "cross-env BROWSERS=all playwright test",
    "test:cleanup": "cross-env CLEANUP=true playwright test",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "Andrea Díaz",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.4",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "exceljs": "^4.4.0",
    "prettier": "^3.9.9",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.0"
  }
}
